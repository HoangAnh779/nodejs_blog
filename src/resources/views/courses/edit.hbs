<div class="mt-4">
    <h3>Sửa Khóa Học</h3>
    <form class="mt-4" method="POST" action="/courses/{{courses._id}}?_method=PUT">
        <div class="form-group">
            <label for="name">Tên Khóa Học</label>
            <input type="text" class="form-control" value="{{courses.name}}" id="name" name="name">
        </div>
        <div class="form-group">
            <label for="description">Mô Tả</label>
            <textarea type="text" class="form-control" id="description" name="description">{{courses.description}}</textarea>
        </div>
        <div class="form-group">
            <label for="keyvideo">Video ID</label>
            <input type="text" class="form-control" value="{{courses.keyvideo}}" id="keyvideo" name="keyvideo">
        </div>
        <div class="form-group">
            <label for="level">Trình độ</label>
            <input type="text" class="form-control" value="{{courses.level}}" id="level" name="level">
        </div>
        <button type="submit" class="btn btn-primary">Lưu lại</button>
    </form>
</div>